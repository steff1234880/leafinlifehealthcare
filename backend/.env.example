# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/leafinlife

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Payment Gateway - Razorpay Test Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Initial Admin User Credentials (Optional - Defaults to admin@leafinlifehealthcare.com)
ADMIN_EMAIL=admin@leafinlifehealthcare.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=Leaf In Life Administrator
ADMIN_PHONE=9876543211

